{
  "manifest_version": 3,
  "name": "Lectio+",
  "version": "2.0.0",
  "description": "Lectio i ét roligt design med overblik, hvad er ændret, fraværsberegner, snit-simulator og notifikationer. Data bliver hos dig.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lectio+"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "alarms",
    "offscreen"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://www.lectio.dk/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.lectio.dk/lectio/*"
      ],
      "js": [
        "early.js"
      ],
      "css": [
        "styles/tokens.css",
        "styles/lectio.css",
        "styles/views.css",
        "styles/shell.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.lectio.dk/lectio/*"
      ],
      "js": [
        "src/main/click.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.lectio.dk/lectio/*"
      ],
      "js": [
        "src/lib/core.js",
        "src/lib/subjects.js",
        "src/lib/parse.js",
        "src/lib/dark.js",
        "src/lib/tidy.js",
        "src/lib/grades.js",
        "src/lib/week.js",
        "src/lib/changes.js",
        "src/lib/absence.js",
        "src/lib/busy.js",
        "src/lib/day.js",
        "src/lib/icons.js",
        "src/shell/nav.js",
        "src/shell/shell.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://www.lectio.dk/*"
      ]
    }
  ]
}
