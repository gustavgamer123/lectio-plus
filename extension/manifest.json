{
  "manifest_version": 3,
  "name": "Lectio+",
  "version": "1.6.1",
  "description": "Et roligere og mere overskueligt Lectio: overblik, nyt ugeskema, mørk tilstand og hurtig søgning (Ctrl+K).",
  "icons": {
    "128": "icon128.png",
    "48": "icon48.png",
    "16": "icon16.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lectio+"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.lectio.dk/lectio/*"
      ],
      "js": [
        "early.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.lectio.dk/lectio/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://www.lectio.dk/*"
      ]
    }
  ]
}